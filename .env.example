# Salin file ini menjadi ".env" DI FOLDER YANG SAMA (Great Expectations/),
# lalu isi nilai sebenarnya. JANGAN commit file ".env" ke Git — sudah
# dikecualikan lewat .gitignore.
#
# validate.py / build_reference.py / scaffold.py membaca file ini otomatis
# lewat load_dotenv() — dicari mulai dari folder tempat script ini berada,
# BUKAN dari folder Phase 1/LoadParquetProcess. Kredensial di folder itu
# adalah proyek yang terpisah dan tidak ikut terbaca di sini.
#
# Hanya diperlukan bila memakai --source s3. Validasi dari file lokal
# (--source lokal, default) tidak butuh kredensial ini sama sekali.

AWS_ACCESS_KEY_ID=KEY_ID
AWS_SECRET_ACCESS_KEY=SECRET_KEY
AWS_REGION=REGION
S3_BUCKET_NAME=BUCKET_NAME

# Hanya diperlukan oleh dimensi 9 (REKONSILIASI SUMBER) — dilewati otomatis
# kalau dataset tidak mendeklarasikan 'sumber.sql_server.tabel', atau kalau
# validate.py dijalankan dengan --no-reconcile. Nama variabel & pola koneksi
# SAMA dengan Phase 1/LoadParquetProcess/.env (pyodbc, SQL Authentication,
# ODBC Driver 17 for SQL Server) — TAPI file .env itu terpisah, tidak dibaca
# otomatis dari sini.

SQLSERVER_HOST=HOST_ATAU_IP
SQLSERVER_DB=NAMA_DATABASE
SQLSERVER_UID=USERNAME
SQLSERVER_PWD=PASSWORD

# Notifikasi email untuk kegagalan validasi (EmailAction bawaan Great
# Expectations, dipasang di dqcore/docs.py). Dilewati otomatis kalau
# SMTP_HOST/SMTP_PORT/SMTP_RECEIVER_EMAILS belum lengkap, atau kalau
# validate.py dijalankan dengan --no-email. Terkirim untuk KEGAGALAN APA
# PUN (blocking maupun warning) — lihat README.md bagian "Notifikasi Email".
#
# SMTP_RECEIVER_EMAILS boleh lebih dari satu, pisahkan dengan koma.
# SMTP_LOGIN/SMTP_PASSWORD boleh dikosongkan HANYA bila server SMTP tidak
# butuh autentikasi (jarang untuk SMTP nyata).
# SMTP_USE_TLS/SMTP_USE_SSL: isi "true" atau "false". Pilih salah satu,
# bukan keduanya — default di sini SSL (port 465), ganti ke TLS (port 587)
# kalau providernya begitu (mis. banyak setup Office 365/Gmail).
#
# SMTP_SENDER_ALIAS PENTING: GX memakainya LANGSUNG sebagai alamat pengirim
# (envelope MAIL FROM *dan* header From ke server SMTP) — WAJIB alamat email
# valid, BUKAN sekadar label/nama bebas seperti "Data Quality Alert" saja
# (server akan menolak dengan "501 Sender address is invalid"). Format yang
# benar: "Nama Tampilan <alamat@domain>", atau kosongkan saja baris ini —
# GX otomatis memakai SMTP_LOGIN sebagai pengirim (paling aman).

SMTP_HOST=smtp.namaperusahaan.com
SMTP_PORT=465
SMTP_LOGIN=alamat-pengirim@namaperusahaan.com
SMTP_PASSWORD=PASSWORD_ATAU_APP_PASSWORD
SMTP_SENDER_ALIAS=Data Quality Alert <alamat-pengirim@namaperusahaan.com>
SMTP_RECEIVER_EMAILS=penerima1@namaperusahaan.com,penerima2@namaperusahaan.com
SMTP_USE_SSL=true
SMTP_USE_TLS=false
