# Salin file ini menjadi ".env" DI FOLDER YANG SAMA (Great Expectations/),
# lalu isi nilai sebenarnya. JANGAN commit file ".env" ke Git — sudah
# dikecualikan lewat .gitignore.
#
# validate.py / build_reference.py / scaffold.py membaca file ini otomatis
# lewat load_dotenv() — dicari mulai dari folder tempat script ini berada,
# BUKAN dari folder Phase 1/LoadParquetProcess. Kredensial di folder itu
# adalah proyek yang terpisah dan tidak ikut terbaca di sini.
#
# Hanya diperlukan bila memakai --source s3. Validasi dari file lokal
# (--source lokal, default) tidak butuh kredensial ini sama sekali.

AWS_ACCESS_KEY_ID=KEY_ID
AWS_SECRET_ACCESS_KEY=SECRET_KEY
AWS_REGION=REGION
S3_BUCKET_NAME=BUCKET_NAME

# Hanya diperlukan oleh dimensi 9 (REKONSILIASI SUMBER) — dilewati otomatis
# kalau dataset tidak mendeklarasikan 'sumber.sql_server.tabel', atau kalau
# validate.py dijalankan dengan --no-reconcile. Nama variabel & pola koneksi
# SAMA dengan Phase 1/LoadParquetProcess/.env (pyodbc, SQL Authentication,
# ODBC Driver 17 for SQL Server) — TAPI file .env itu terpisah, tidak dibaca
# otomatis dari sini.

SQLSERVER_HOST=HOST_ATAU_IP
SQLSERVER_DB=NAMA_DATABASE
SQLSERVER_UID=USERNAME
SQLSERVER_PWD=PASSWORD
