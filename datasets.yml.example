# ===========================================================================
# CONTOH datasets.yml — salin jadi "datasets.yml" lalu isi dengan dataset
# Anda sendiri.
#
# datasets.yml ASLI TIDAK masuk Git (lihat .gitignore) karena isinya struktur
# data internal organisasi: nama tabel, nama kolom bisnis, nama bucket S3,
# daftar kode wilayah/unit, dsb. Berkas CONTOH ini sengaja memakai nama
# generik/fiktif supaya aman untuk di-versi-kan dan dipakai sebagai referensi
# oleh siapa pun yang baru clone repo ini.
#
# CARA PAKAI:
#   1. copy datasets.yml.example datasets.yml      (Linux/Mac: cp ...)
#   2. Hapus/ganti dataset contoh di bawah dengan dataset Anda sendiri.
#      Lebih baik jangan ketik kolom manual — jalankan scaffold.py dari file
#      parquet yang sudah ada (lihat README.md bagian "Menambah dataset baru").
#   3. python build_reference.py --dataset <nama>
#      python validate.py --dataset <nama>
#
# Referensi lengkap semua field yang dikenal ada di komentar inline di bawah,
# atau baca dqcore/spec.py (fungsi _dataset_dari_yaml / _kolom_dari_yaml).
# ===========================================================================

default:
  # Dipakai semua dataset kecuali ditimpa di blok datasetnya sendiri.
  ambang:
    toleransi_volume: 0.15   # koridor jumlah baris = median historis +/- 15%
    batas_kl: 1.0            # ambang KL divergence terhadap sebaran baseline
    batas_zscore: 20.0       # ambang outlier ekstrem
    margin_null: 0.05        # kelonggaran di atas null rate historis terburuk
    # Margin koridor DISTRIBUTION (mean/stdev/kuantil) — lihat dqcore/profile.py
    # & dqcore/checks.py bagian DISTRIBUTION untuk artinya masing-masing.
    margin_mean: 2.0
    margin_stdev: 2.0
    margin_kuantil_bawah: 0.5
    margin_kuantil_atas: 1.5
  sla_lag_hari:
    harian: 2.0              # pipeline harian: data H-1 masuk paling lambat H+1
    backfill: 260.0          # muat ulang historis: lag besar itu wajar

  # Opsional — dimensi 12 (LINEAGE & AUDITABILITY). Berlaku ke SEMUA dataset
  # di bawah kecuali dataset itu mendeklarasikan 'meta_audit:' sendiri (lihat
  # 'contoh_master_unit' di bawah untuk contoh opt-out). Diperiksa terhadap
  # skema BERKAS langsung, bukan cuma daftar 'kolom:' — jadi kontrak audit
  # ini tetap tegak walau 'kolom:' sendiri lupa mendaftarkan kolomnya. Hapus
  # blok ini sepenuhnya (di sini maupun di tiap dataset) kalau tidak dipakai.
  meta_audit:
    wajib: [bronze_inserted_at, source_system_name, job_run_id]

datasets:

  # =========================================================================
  # CONTOH 1 — dataset TRANSAKSIONAL dengan partisi harian (pola paling umum).
  # Ganti SELURUH isi blok ini: nama dataset, kolom, relasi, dst.
  # =========================================================================
  contoh_sensor_harian:
    deskripsi: "TODO — jelaskan isi dataset ini dalam satu kalimat"

    sumber:
      # Salah satu boleh dikosongkan. Pakai --source untuk memilih saat validasi.
      lokal: "path/ke/output/gold_contoh_sensor_*.parquet"
      s3: "s3://${S3_BUCKET_NAME}/datalake/gold/contoh_sensor"
      partisi: harian        # harian | mingguan | snapshot | tanpa_partisi

      # Opsional — hanya dipakai dimensi 9 (REKONSILIASI SUMBER), bandingkan
      # row count & skema terhadap SQL Server live. Lihat README.md bagian
      # "Akses SQL Server". Hapus blok ini kalau tidak dipakai; dimensi 9
      # otomatis dilewati bila 'tabel' tidak diisi.
      # sql_server:
      #   tabel: "dbo.NAMA_TABEL_SUMBER_ANDA"
      #   kolom_waktu: recorded_at
      #   offset_jam: 0

    # Opsional — dimensi 11 (COST & STORAGE SAFETY). Properti BERKAS (bytes),
    # bukan properti kolom, jadi levelnya di sini (dataset), bukan di dalam
    # 'kolom:'. Hapus blok ini kalau tidak dipakai; dimensi 11 otomatis
    # dilewati bila tidak diisi. Cuma mengecek partisi yang sedang divalidasi
    # — BUKAN audit jumlah berkas kecil di seluruh prefix S3 (lihat README.md
    # bagian dimensi 11 untuk kenapa itu di luar cakupan).
    # ukuran_berkas:
    #   rentang: [10000, 524288000]   # 10 KB - 500 MB, dalam bytes

    kunci:
      surrogate: id_baris             # kunci teknis, selalu unik
      bisnis: [unit_id, recorded_at]  # kunci yang benar-benar bermakna
      waktu: recorded_at              # waktu kejadian
      waktu_muat: loaded_at           # waktu diproses ETL
      # granularitas: jam             # satu pembacaan per unit per jam

    # Urutan di bawah ini ADALAH urutan kolom yang diharapkan pada file.
    #   wajib: false        -> kolom boleh null
    #   referensi: true     -> nilainya dicek terhadap daftar master
    #   profil_distribusi   -> ikut check DISTRIBUTION (mean, kuantil, KL)
    #   rentang             -> batas fisik; batas ini mengalahkan baseline
    #   pola                -> regex, dimensi 8 (DATA CLEANLINESS & ENCODING).
    #                          Kalau dikosongkan, pola DITURUNKAN OTOMATIS
    #                          dari data historis — soal konsistensi bentuk.
    #   regex               -> regex, dimensi 10 (FORMAT & PATTERN COMPLIANCE).
    #                          TIDAK PERNAH diturunkan otomatis — assertion
    #                          standar format bisnis eksternal (nomor telepon,
    #                          tanggal ISO 8601, dst.), beda tujuan dari 'pola'
    #                          walau sama-sama regex. Boleh satu string atau
    #                          list ["...", "..."] untuk beberapa format sah.
    kolom:
      - {nama: id_baris,       tipe: integer}
      - {nama: unit_id,        tipe: string,  referensi: true}
      - {nama: recorded_at,    tipe: datetime}
      - {nama: loaded_at,      tipe: datetime}
      - {nama: kategori_unit,  tipe: string,  referensi: true}
      - {nama: is_manual,      tipe: boolean}
      - {nama: area_code,      tipe: string,  referensi: true}
      - nama: nilai_ukur
        tipe: decimal
        wajib: false               # sensor tidak selalu melapor
        rentang: [0, 1000]         # batas yang MUNGKIN secara fisik,
        satuan: "unit"             # bukan yang kebetulan terlihat di data
        profil_distribusi: true    # <- mengaktifkan dimensi DISTRIBUTION
      - {nama: dq_nilai_valid, tipe: boolean}
      - nama: kontak_telepon
        tipe: string
        wajib: false
        regex: "^08\\d{9,11}$"     # <- mengaktifkan dimensi FORMAT & PATTERN COMPLIANCE

    # Pasangan kolom yang hubungannya harus tetap konsisten (parent -> child).
    relasi:
      - [unit_id, area_code]

    # Kolom yang nilainya harus persis sama dalam satu baris. Kosongkan
    # ([]) atau hapus baris ini kalau tidak ada.
    sama_nilai: []

    # A harus >= B.
    urutan_waktu:
      - [loaded_at, recorded_at]

    # Dua pola berbeda di bawah, masing-masing masuk dimensi berbeda:
    #   aturan: ada / ada_dan_dalam_rentang -> Business Logic Consistency
    #     (dimensi 6. INTEGRITY): flag == kondisi pada kolom lain, keduanya
    #     wajib selalu sinkron.
    #   harus: true/false -> audit keseragaman sinyal QA dari pipeline hulu
    #     (dimensi 5. UNIQUENESS): seluruh nilai dalam partisi harus konstanta itu.
    flag_dq:
      - flag: dq_nilai_valid
        kolom: nilai_ukur
        aturan: ada_dan_dalam_rentang

  # =========================================================================
  # CONTOH 2 — dataset MASTER/DIMENSI tanpa partisi waktu (partisi: snapshot).
  # Tidak punya dimensi waktu: kosongkan 'kunci.waktu' dan 'granularitas'.
  # Dimensi FRESHNESS otomatis dilewati dengan alasan yang dicatat — bukan
  # lulus diam-diam.
  # =========================================================================
  contoh_master_unit:
    deskripsi: "TODO — daftar referensi unit/wilayah"

    sumber:
      s3: "s3://${S3_BUCKET_NAME}/datalake/gold/contoh_master_unit"
      partisi: snapshot

    # Opt-out dari standar 'meta_audit' global di blok 'default:' — dataset
    # master/dimensi seperti ini biasanya tidak punya siklus hidup Bronze
    # yang perlu ditelusuri per baris. Timpa TOTAL (kosongkan), bukan hapus
    # baris ini — menghapusnya berarti IKUT standar global, bukan opt-out.
    meta_audit:
      wajib: []

    kolom:
      - {nama: kode, tipe: string}
      - {nama: nama, tipe: string}
